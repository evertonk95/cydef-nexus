# ============================================================================
# CyDef Academy — variáveis de ambiente (repo PÚBLICO: nenhum valor real aqui).
# Copie para .env.local (dev) e configure segredos via Actions secrets / env do
# provedor (nunca no repo — ver .gitignore `.env*`).
# ============================================================================

# --- SPA (Vite) ---
# Rota da landing (constante única em src/lib/config.ts)
# VITE_LANDING_PATH=/academy/gratuito
# Endpoint público da Capture API (Edge Function) — ex.: https://<ref>.supabase.co/functions/v1
VITE_CAPTURE_API_URL=
# Flags de funcionalidade (default DESLIGADO — fail secure; ligar apenas no go-live aprovado)
VITE_CAPTURE_ENABLED=false
VITE_EMAIL_ENABLED=false
VITE_ANALYTICS_ENABLED=false
# Endpoint do beacon de analytics sem PII (eventos próprios)
VITE_ANALYTICS_ENDPOINT=
# Supabase do portal (home: contagem real de alunos da Academy)
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon public — chave pública por design, vai no bundle>
# Contagem pública de alunos na home (RPC contagem_alunos — só agregados, sem PII)
VITE_ACADEMY_STATS_ENABLED=false

# --- Edge Functions (Supabase Edge Runtime / secret manager) ---
# URL do projeto (ex.: https://<project-ref>.supabase.co)
# SUPABASE_URL=
# Credencial da role de função (EXECUTE em RPCs apenas — HEL-M03; NUNCA service role plena)
# SUPABASE_SERVICE_ROLE_KEY=
# Flag de e-mail (default false)
# EMAIL_ENABLED=false
# Chave de API do Resend (secret manager — nunca no repo)
# RESEND_API_KEY=
# Remetente verificado (DNS/SPF/DKIM/DMARC — aprovação Everton)
# RESEND_FROM=Academy CyDef <academy@cydef.com.br>
# URL pública da API p/ montar o link de confirmação no e-mail
# API_PUBLIC_BASE_URL=
